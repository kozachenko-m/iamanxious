{
  "name": "iamanxious",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "26.x",
    "bun": ">=1.4.5"
  },
  "scripts": {
    "dev:convex": "bunx convex dev",
    "dev:web": "next dev --turbopack",
    "dev": "bunx concurrently -k -s first -n convex,web -c \"cyan.bold,magenta.bold\" \"bun dev:convex\" \"bun dev:web\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "convex": "^1.51.0",
    "csv-parse": "^7.0.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
